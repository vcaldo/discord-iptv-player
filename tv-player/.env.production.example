# Production environment configuration template for tv-player
# Copy this file to .env.production for production settings

# Discord configuration
TOKEN=your_discord_token_here
GUILD_ID=your_guild_id_here
VIDEO_CHANNEL_ID=your_video_channel_id_here

# Stream configuration - optimized for production
STREAM_RESPECT_VIDEO_PARAMS=true
STREAM_WIDTH=1280
STREAM_HEIGHT=720
STREAM_FPS=30
STREAM_BITRATE_KBPS=800
STREAM_MAX_BITRATE_KBPS=3000
STREAM_HARDWARE_ACCELERATION=true
STREAM_VIDEO_CODEC=VP8

# Redis configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_PUB_SUB_CHANNEL=iptv

# Environment
NODE_ENV=production