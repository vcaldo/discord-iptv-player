# Example .env file for tv-player
# Copy this file to .env and fill in the required values

# Discord configuration
TOKEN=your_discord_token_here
GUILD_ID=your_guild_id_here

# Stream configuration
STREAM_RESPECT_VIDEO_PARAMS=false
STREAM_WIDTH=1920
STREAM_HEIGHT=1080
STREAM_FPS=60
STREAM_BITRATE_KBPS=1000
STREAM_MAX_BITRATE_KBPS=4200
STREAM_HARDWARE_ACCELERATION=false
# Valid options for video codec: VP8, VP9, H264, H265
STREAM_VIDEO_CODEC=H264

# Redis configuration
REDIS_HOST=localhost
REDIS_PORT=6379
# Redis password is optional, can be left empty
REDIS_PASSWORD=your_redis_password_here
REDIS_PUB_SUB_CHANNEL=iptv

# Environment
# Valid options: development, production, test
NODE_ENV=development