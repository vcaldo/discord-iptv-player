# Discord configuration
TOKEN=your_discord_token_here
GUILD_ID=your_guild_id_here

# --- Stream Quality Presets ---
# Uncomment ONE preset below, or set custom values.

# High quality (1080p60)
# STREAM_WIDTH=1920
# STREAM_HEIGHT=1080
# STREAM_FPS=60
# STREAM_BITRATE_KBPS=7000
# STREAM_MAX_BITRATE_KBPS=10000
# STREAM_VIDEO_CODEC=H265

# Mid quality (720p30)
# STREAM_WIDTH=1280
# STREAM_HEIGHT=720
# STREAM_FPS=30
# STREAM_BITRATE_KBPS=3000
# STREAM_MAX_BITRATE_KBPS=5000
# STREAM_VIDEO_CODEC=H264

# Low quality (480p30)
# STREAM_WIDTH=854
# STREAM_HEIGHT=480
# STREAM_FPS=30
# STREAM_BITRATE_KBPS=1000
# STREAM_MAX_BITRATE_KBPS=2000
# STREAM_VIDEO_CODEC=H264

STREAM_HARDWARE_ACCELERATION=false

# Redis configuration
# Redis is always used for pub/sub commands.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_PUB_SUB_CHANNEL=iptv

# Persistent storage configuration
# Match this with remote-control's STORAGE_ENGINE.
STORAGE_ENGINE=redis
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=discord_iptv_player
POSTGRES_SSLMODE=disable
# Alternatively set POSTGRES_DSN=postgres://postgres:postgres@postgres:5432/discord_iptv_player?sslmode=disable

# New Relic (optional)
# NEW_RELIC_APP_NAME=Discord IPTV Player - TV Service v2
# NEW_RELIC_LICENSE_KEY=your_license_key_here
